# LLM — DeepSeek (OpenAI-compatible chat completions + tool calling)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Supabase (Postgres + pgvector)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# n8n handles embeddings + vector search (DeepSeek has no embeddings endpoint).
# Hugging Face Inference embeddings -> Supabase Vector Store, orchestrated in n8n.
N8N_RETRIEVAL_URL=

# Fish Audio (voice in/out)
FISH_AUDIO_API_KEY=

# n8n orchestration
# n8n calls /api/tools for exact figures; the app calls n8n for chat + retrieval.
N8N_CHAT_URL=
N8N_WEBHOOK_SECRET=
COACH_TOOL_SECRET=
