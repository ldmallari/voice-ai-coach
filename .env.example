# LLM — DeepSeek (OpenAI-compatible chat completions + tool calling)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Supabase (Postgres + pgvector)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# n8n handles embeddings + vector search (DeepSeek has no embeddings endpoint).
# Cohere embed-english-v3.0 -> Supabase Vector Store, orchestrated in n8n.
# The Cohere key lives in n8n as a credential, not here.
N8N_RETRIEVAL_URL=

# Fish Audio (voice in/out)
FISH_AUDIO_API_KEY=
# Optional: pin a reference voice so every chunk of an answer speaks in ONE
# consistent voice (copy an id from the Fish Audio playground). Without it the
# free model picks a default speaker per request, which can drift between chunks.
FISH_VOICE_ID=
# Optional overrides: TTS model (default s2.1-pro-free) and ASR language.
FISH_TTS_MODEL=
FISH_ASR_LANGUAGE=

# n8n orchestration
# n8n calls /api/tools for exact figures; the app calls n8n for chat + ingest.
N8N_COACH_URL=
N8N_INGEST_URL=
N8N_WEBHOOK_SECRET=
COACH_TOOL_SECRET=

# Passcode to manage the knowledge base (list/delete uploaded docs)
KNOWLEDGE_ADMIN_PASSCODE=
